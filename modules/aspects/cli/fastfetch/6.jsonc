{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "brightColor": true,
    "disableLinewrap": true,
    "freq": {
      "spaceBeforeUnit": "never",
      "ndigits": 1
    },
    "key": {
      "type": "both-2",
      "width": 14
    },
    "common": {
      "ndigits": 1
    },
    "separator": " "
  },
  "logo": {
    "width": 24,
    "preserveAspectRatio": true
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "blue",
      "keyIcon": "󰒍",
      "key": "User"
    },
    {
      "type": "os",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "keyColor": "blue"
    },
    {
      "type": "media",
      "keyColor": "blue",
      "format": "{artist} - {title}"
    },
    {
      "type": "wifi",
      "format": "{ssid}",
      "keyColor": "blue"
    },
    {
      "type": "locale",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "chassis",
      "keyColor": "green",
      "format": "{type}{vendor}{version}"
    },
    {
      "type": "host",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "keyColor": "green",
      "format": "{name} {temperature} ",
      "temp": true
    },
    {
      "type": "cpu",
      "keyColor": "green",
      "format": "{cores-physical}Cores {cores-logical}Threads {freq-base}"
    },
    {
      "type": "gpu",
      "keyColor": "green",
      "format": "{vendor} {name} {temperature}",
      "temp": true
    },
    {
      "type": "gpu",
      "keyColor": "green",
      "format": "{driver}",
      "key": "Driver"
    },
    {
      "type": "memory",
      "keyColor": "green"
    },
    {
      "type": "display",
      "keyColor": "green",
      "key": "Screen",
      "compactType": "original-with-refresh-rate",
      "order": "desc"
    },
    {
      "type": "battery",
      "keyColor": "green"
    },
    {
      "type": "poweradapter",
      "keyColor": "green"
    },
    {
      "type": "gamepad",
      "keyColor": "green"
    },
    {
      "type": "bluetooth",
      "keyColor": "green"
    },
    {
      "type": "sound",
      "keyColor": "green",
      "format": "{name:25} {volume-percentage}"
    },
    "break",
    {
      "type": "shell",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "keyColor": "yellow"
    },
    {
      "type": "terminalfont",
      "keyColor": "yellow",
      "key": "Mono Font"
    },
    {
      "type": "de",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "keyColor": "yellow",
      "key": "WM",
      "format": "{pretty-name} {version} {protocol-name}"
    },
    {
      "type": "icons",
      "keyColor": "yellow"
    }
  ]
}
