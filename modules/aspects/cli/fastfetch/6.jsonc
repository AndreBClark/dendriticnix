{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "brightColor": true,
    "key": {
      "type": "both",
      "width": 13,
      "paddingLeft": 2
    },
    "common": {
      "ndigits": 1
    },
    "separator": " "
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "blue",
      "keyIcon": "󰒍",
      "key": "User"
    },
    {
      "type": "os",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "keyColor": "blue"
    },
    {
      "type": "media",
      "keyColor": "blue",
      "format": "{combined:40} {progress}"
    },
    {
      "type": "localip",
      "compact": true,
      "keyColor": "blue"
    },
    {
      "type": "wifi",
      "format": "{ssid}",
      "keyColor": "blue"
    },
    {
      "type": "locale",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "chassis",
      "keyColor": "green",
      "format": "{type} {vendor}"
    },
    {
      "type": "host",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "keyColor": "green",
      "key": "disk",
      "showExternal": false,
      "format": "{mountpoint} {filesystem} {size-used}/{size-total}"
    },
    {
      "type": "memory",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "keyColor": "green"
    },
    {
      "type": "display",
      "keyColor": "green",
      "key": "Screen"
    },
    {
      "type": "battery",
      "keyColor": "green"
    },
    {
      "type": "poweradapter",
      "keyColor": "green"
    },
    {
      "type": "gamepad",
      "keyColor": "green"
    },
    {
      "type": "bluetooth",
      "keyColor": "green"
    },
    {
      "type": "sound",
      "keyColor": "green"
    },
    "break",
    {
      "type": "shell",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "keyColor": "yellow"
    },
    {
      "type": "terminalfont",
      "keyColor": "yellow"
    },
    {
      "type": "lm",
      "keyColor": "yellow",
      "key": "Login"
    },
    {
      "type": "de",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "keyColor": "yellow",
      "key": "WM",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "theme",
      "keyColor": "yellow",
      "format": "{theme1} {theme2}"
    },
    {
      "type": "icons",
      "keyColor": "yellow"
    }
  ]
}
