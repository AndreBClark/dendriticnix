hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

blur {
    offset 6
    passes 5
    noise 0.04
}

prefer-no-csd

layout {
    gaps 16
    struts {
        left -14
        right -14
        top -14
        bottom -14
    }
    border {
        width 0
    }
}

layer-rule {
    match namespace="dms:blurwallpaper"
    place-within-backdrop true
}
